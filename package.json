{
  "name": "nougenai-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx cross-env NODE_OPTIONS='--openssl-legacy-provider --max-old-space-size=4096' next dev -p 3000",
    "build": "npx cross-env NODE_OPTIONS='--openssl-legacy-provider --max-old-space-size=4096' next build",
    "start": "npx cross-env NODE_OPTIONS='--openssl-legacy-provider --max-old-space-size=4096' next start -p 3000",
    "lint": "eslint",
    "fleet": "npx cross-env NODE_OPTIONS='--openssl-legacy-provider --max-old-space-size=4096' npx tsx scripts/fleet-commander.ts",
    "dev:vinext": "npx cross-env NODE_OPTIONS='--openssl-legacy-provider --max-old-space-size=4096' vinext dev --port 3001",
    "build:vinext": "npx cross-env NODE_OPTIONS='--openssl-legacy-provider --max-old-space-size=4096' vinext build",
    "start:vinext": "npx cross-env NODE_OPTIONS='--openssl-legacy-provider --max-old-space-size=4096' vinext start",
    "py:audit": "python scripts/audit_python.py --targets scripts",
    "py:audit:full": "python scripts/audit_python.py --targets src scripts tests",
    "py:compile": "python scripts/audit_python.py --targets scripts --skip-pylint",
    "py:pylint": "python scripts/audit_python.py --targets scripts --skip-compile",
    "typecheck": "tsc --noEmit",
    "validate:python": "npm run py:audit",
    "validate": "npm run lint && npm run typecheck && npm run build:vinext && npm run validate:python"
  },
  "dependencies": {
    "@extractus/article-extractor": "^8.1.0",
    "@google-cloud/discoveryengine": "^2.8.0",
    "@google-cloud/vertexai": "^1.12.0",
    "@google/genai": "^1.52.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.20",
    "axios": "^1.18.1",
    "better-sqlite3": "^12.11.1",
    "cesium": "^1.143.0",
    "cheerio": "^1.2.0",
    "cloudinary": "^2.10.0",
    "discord.js": "^14.27.0",
    "express": "^4.22.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^12.42.2",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.577.0",
    "luxon": "^3.7.2",
    "next": "^16.2.10",
    "next-devtools-mcp": "^0.4.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "rss-parser": "^3.13.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "whatsapp-web.js": "^1.34.7",
    "cross-env": "^7.0.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cli-progress": "^3.11.6",
    "@types/express": "^4.17.25",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-rsc": "^0.5.28",
    "cli-progress": "^3.12.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "react-server-dom-webpack": "^19.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vinext": "^0.0.55",
    "vite": "^8.1.5"
  },
  "overrides": {
    "postcss": "^8.5.14",
    "firebase-admin": {
      "@google-cloud/firestore": "^8.6.0"
    },
    "@google-cloud/storage": {
      "teeny-request": "^10.1.2"
    },
    "teeny-request": {
      ".": "^10.1.2",
      "http-proxy-agent": "^7.0.2"
    }
  },
  "type": "module"
}
